{
  "$schema": "https://raw.githubusercontent.com/nicr9/tauri-v2-schema/main/tauri.conf.v2.schema.json",
  "productName": "Edify",
  "version": "0.1.0",
  "identifier": "app.edify.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Edify",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
